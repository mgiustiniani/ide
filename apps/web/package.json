{
  "name": "@ide/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone webapp for the IDE (no Tauri dependency)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@ide/browser-adapters": "workspace:*",
    "@ide/contracts": "workspace:*",
    "@ide/ui": "workspace:*",
    "@ide/web-core": "workspace:*",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.10.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
