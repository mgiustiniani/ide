{
  "name": "@ide/browser-adapters",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-safe implementations of storage, fetch, notifications, clipboard, and other web capabilities",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@ide/contracts": "workspace:*",
    "@ide/web-core": "workspace:*"
  },
  "devDependencies": {
    "eslint": "^9.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  }
}
