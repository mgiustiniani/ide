{
  "name": "@ide/tauri-adapters",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tauri runtime adapters for the IDE (native bridge)",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts packages/tauri-adapters/src"
  },
  "dependencies": {
    "@ide/contracts": "workspace:*",
    "@ide/web-core": "workspace:*",
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "eslint": "^9.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  }
}
